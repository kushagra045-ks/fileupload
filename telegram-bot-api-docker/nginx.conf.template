worker_processes auto;
# Alpine's nginx package defaults to running worker processes as a
# restricted "nginx" user when this isn't set. telegram-bot-api (started
# by our entrypoint) runs as root and writes files that user can't read,
# which is exactly what causes a 403 on an otherwise-correct static file
# request. Matching both processes to root removes that mismatch. This
# container isn't multi-tenant and this port isn't meant to be exposed
# beyond your own services, so the usual reasons to avoid running nginx
# as root don't really apply here — but if you harden this later, the
# alternative is telling telegram-bot-api to run as the "nginx" user
# instead via --username/--groupname.
user root;
events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;

  # Generous limits/timeouts since this exists specifically to move large
  # files. Response size (downloads) isn't limited by nginx by default;
  # these mainly matter for keeping slow transfers alive rather than
  # getting cut off partway through.
  client_max_body_size 4096m;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
  send_timeout 3600s;

  server {
    listen __PORT__;

    # Every real Bot API call (getFile, getUpdates, sendMessage, ...) is
    # shaped like /bot<token>/<method> — forward all of those straight to
    # the actual telegram-bot-api process running internally.
    location /bot {
      proxy_pass http://127.0.0.1:__BOTAPI_INTERNAL_PORT__;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
    }

    # Everything else is treated as a raw file path. In --local mode,
    # getFile returns an absolute path like
    # /var/lib/telegram-bot-api/<bot_id>/documents/x.jpg — our Node code
    # strips that known prefix and requests the remainder here, which
    # nginx serves straight off the same disk telegram-bot-api wrote to.
    location / {
      root /var/lib/telegram-bot-api;
      autoindex off;
    }
  }
}
